<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    forest_clustered_10min para o LIMO: mesmas 39 arvores e o mesmo chao plano do
    octomap_gazebo_forest/worlds/forest_clustered_10min.sdf, com os sistemas que o
    LIMO precisa e que o mundo do drone nao declara (Sensors p/ o Livox, Imu).
    O nome "cerrado" e obrigatorio: o limo_cerrado.launch.py faz o spawn em -world cerrado.
    Modelos: octomap_gazebo_forest/models e models/forest-gen-models no GZ_SIM_RESOURCE_PATH
    (feito na session.yml); o grass_plane vem de /opt/ros/jazzy/share.
  -->
  <world name="cerrado">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.38 0.40 0.43 1</ambient>
      <background>0.66 0.78 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 15 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.95 0.91 0.80 1</diffuse>
      <specular>0.12 0.12 0.10 1</specular>
      <direction>-0.45 0.35 -0.82</direction>
      <attenuation><range>1000</range><constant>1</constant><linear>0</linear><quadratic>0</quadratic></attenuation>
    </light>

    <include><uri>model://benchmark_fg_tree_2</uri><name>clustered_tree_001</name><pose>-4.433 -8.179 0 0 0 1.366179</pose></include><!-- forest-gen-models/tree_2; DAP=0.230 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_002</name><pose>-7.747 -5.767 0 0 0 1.085065</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_003</name><pose>-5.482 -6.317 0 0 0 1.793679</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_004</name><pose>-9.216 -11.612 0 0 0 -2.533834</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_fg_tree_2</uri><name>clustered_tree_005</name><pose>-9.572 -9.383 0 0 0 2.677053</pose></include><!-- forest-gen-models/tree_2; DAP=0.230 m -->
    <include><uri>model://benchmark_fg_tree_2</uri><name>clustered_tree_006</name><pose>-11.658 -9.515 0 0 0 -1.840851</pose></include><!-- forest-gen-models/tree_2; DAP=0.230 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_007</name><pose>-12.825 -13.386 0 0 0 -1.221388</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_fg_tree_2</uri><name>clustered_tree_008</name><pose>-6.963 -3.225 0 0 0 -1.954422</pose></include><!-- forest-gen-models/tree_2; DAP=0.230 m -->
    <include><uri>model://benchmark_new_tree_1</uri><name>clustered_tree_009</name><pose>-9.068 -7.367 0 0 0 -2.018293</pose></include><!-- new_tree_1; DAP=0.230 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_010</name><pose>-9.129 -3.146 0 0 0 2.987648</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_011</name><pose>-1.482 -2.338 0 0 0 0.348683</pose></include><!-- world_jean_tree; DAP=0.210 m -->
