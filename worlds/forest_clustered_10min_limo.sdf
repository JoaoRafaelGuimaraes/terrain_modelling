    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_018</name><pose>4.236 12.322 0 0 0 2.090120</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_019</name><pose>13.224 14.449 0 0 0 2.729478</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_fg_tree_9</uri><name>clustered_tree_020</name><pose>9.474 9.281 0 0 0 2.413201</pose></include><!-- forest-gen-models/tree_9; DAP=0.160 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_021</name><pose>9.170 11.397 0 0 0 0.353014</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_new_tree_1</uri><name>clustered_tree_022</name><pose>5.307 8.762 0 0 0 -0.850191</pose></include><!-- new_tree_1; DAP=0.230 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_023</name><pose>14.148 5.706 0 0 0 -1.052146</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_new_tree_1</uri><name>clustered_tree_024</name><pose>8.959 7.506 0 0 0 0.698039</pose></include><!-- new_tree_1; DAP=0.230 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_025</name><pose>5.156 10.355 0 0 0 1.393852</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_026</name><pose>6.876 6.874 0 0 0 1.307319</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_027</name><pose>12.228 8.773 0 0 0 1.428574</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_028</name><pose>-3.464 5.289 0 0 0 0.493923</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_029</name><pose>-6.839 9.226 0 0 0 0.093189</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_030</name><pose>-7.874 11.017 0 0 0 -2.928878</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_new_tree_1</uri><name>clustered_tree_031</name><pose>-6.734 4.538 0 0 0 0.394128</pose></include><!-- new_tree_1; DAP=0.230 m -->
