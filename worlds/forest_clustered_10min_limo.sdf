    <include><uri>model://benchmark_fg_tree_9</uri><name>clustered_tree_035</name><pose>-2.608 10.755 0 0 0 -2.392010</pose></include><!-- forest-gen-models/tree_9; DAP=0.160 m -->
    <include><uri>model://benchmark_new_tree_1</uri><name>clustered_tree_036</name><pose>-4.100 11.284 0 0 0 1.203632</pose></include><!-- new_tree_1; DAP=0.230 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_037</name><pose>9.227 -8.703 0 0 0 -1.035112</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_038</name><pose>9.102 -10.759 0 0 0 0.317244</pose></include><!-- world_jean_tree; DAP=0.210 m -->
    <include><uri>model://benchmark_world_jean_tree</uri><name>clustered_tree_039</name><pose>10.840 -9.553 0 0 0 2.421746</pose></include><!-- world_jean_tree; DAP=0.210 m -->

    <include>
      <uri>model://mrs_gazebo_common_resources/models/grass_plane</uri>
      <name>grass_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
